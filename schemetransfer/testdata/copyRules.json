{
  "version": 1,
  "mode": "declared",
  "settings": {
    "kind": "object",
    "unknownFields": "reject",
    "fields": {
      "accountId": {
        "kind": "reference",
        "resource": {
          "kind": "integrationResource",
          "sourceKey": "paymentAccounts"
        },
        "readAs": "value",
        "writeAs": "value",
        "empty": "requireBinding",
        "constraints": {
          "mode": "live",
          "capabilities": [
            "issueInvoice"
          ]
        }
      },
      "productId": {
        "kind": "reference",
        "resource": {
          "kind": "integrationResource",
          "sourceKey": "products"
        },
        "readAs": "value",
        "writeAs": "value",
        "empty": "preserveNone"
      },
      "paymentUrlVariable": {
        "kind": "reference",
        "resource": {
          "kind": "subjectVariable",
          "owner": "projectOrThisIntegration",
          "valueType": "string"
        },
        "readAs": "key",
        "writeAs": "key",
        "access": "write",
        "empty": "bindDefault",
        "defaultReference": {
          "owner": "thisIntegration",
          "key": "payment_url"
        }
      },
      "title": {
        "kind": "template",
        "dialect": "aheronVarsV1"
      },
      "description": {
        "kind": "template",
        "dialect": "aheronVarsV1"
      },
      "amount": {
        "kind": "template",
        "dialect": "aheronVarsV1"
      },
      "email": {
        "kind": "template",
        "dialect": "aheronVarsV1"
      },
      "phone": {
        "kind": "template",
        "dialect": "aheronVarsV1"
      },
      "returnUrl": {
        "kind": "template",
        "dialect": "aheronVarsV1"
      },
      "currency": {
        "kind": "literal",
        "valueType": "string"
      },
      "vatRate": {
        "kind": "literal",
        "valueType": "string"
      },
      "paymentSubject": {
        "kind": "literal",
        "valueType": "string"
      },
      "paymentMethod": {
        "kind": "literal",
        "valueType": "string"
      },
      "ttlMinutes": {
        "kind": "literal",
        "valueType": "integer"
      },
      "twoStage": {
        "kind": "literal",
        "valueType": "boolean"
      },
      "saveBinding": {
        "kind": "literal",
        "valueType": "boolean"
      },
      "allowRepeat": {
        "kind": "literal",
        "valueType": "boolean"
      },
      "issueReceipt": {
        "kind": "literal",
        "valueType": [
          "boolean",
          "null"
        ]
      },
      "outputs": {
        "kind": "array",
        "items": {
          "kind": "literal",
          "valueType": "string"
        }
      },
      "outcomeOutputs": {
        "kind": "map",
        "keys": "literal",
        "values": {
          "kind": "literal",
          "valueType": "string"
        }
      }
    }
  },
  "implicitResources": [
    {
      "kind": "subjectVariable",
      "owner": "thisIntegration",
      "key": "order_id",
      "valueType": "string",
      "access": "write"
    },
    {
      "kind": "subjectVariable",
      "owner": "thisIntegration",
      "key": "payment_id",
      "valueType": "string",
      "access": "write"
    },
    {
      "kind": "subjectVariable",
      "owner": "thisIntegration",
      "key": "payment_amount",
      "valueType": "number",
      "access": "write"
    }
  ],
  "notes": "Исследовательский пример. Полный список неявных записей должен извлекаться из контракта интеграции; текущий backend эти поля не поддерживает.",
  "validation": {
    "mode": "integration"
  }
}
